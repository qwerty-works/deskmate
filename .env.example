AWTRIX_HOST=http://192.168.4.94
CODEX_MAX_AGE_SECONDS=3600

# Leave blank to query the Codex CLI on this machine.
# On the Pi, set this to your Mac's SSH destination (or SSH config alias).
CODEX_SSH_HOST=

# Optional Codex home containing the existing login state.
# Defaults to ~/.codex (or the remote Mac's CODEX_HOME).
# In SSH mode this path is on the Mac, not the Pi. Do not set it to the repo.
CODEX_HOME=

# Relative paths resolve from the checkout, including when cron runs elsewhere.
GOOGLE_CALENDAR_CREDENTIALS_PATH=.google-calendar/credentials.json
GOOGLE_CALENDAR_TOKEN_PATH=.google-calendar/token.json
GOOGLE_CALENDAR_TIMEZONE=America/New_York
